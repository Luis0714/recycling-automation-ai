# =====================================================================
# Smart Recycling — variables de entorno (Python).
# Copia este archivo a `.env` y completa los valores.
#
# Fuentes de los valores:
#   - Supabase: Project Settings → API
#       RAS_SUPABASE_URL       = Project URL
#       RAS_SUPABASE_SERVICE_KEY = service_role secret (SOLO servidor)
#   - Arduino: Administrador de dispositivos (Windows) o `ls /dev/ttyUSB*` (Linux)
# =====================================================================

# ---- Hardware ---------------------------------------------------------
# Puerto serial del Arduino. Déjalo vacío para autodetectar si solo hay uno.
RAS_SERIAL_PORT=
RAS_SERIAL_BAUDRATE=9600
RAS_SERIAL_TIMEOUT_S=1.0

# Cámara (0 = webcam por defecto).
RAS_CAMERA_DEVICE_INDEX=0

# ---- Modelo YOLO ------------------------------------------------------
# Ruta local al .pt (si no existe, se descarga desde Hugging Face).
RAS_YOLO_MODEL_PATH=model/yolov8n-waste-12cls-best.pt
# None = autodetectar CUDA/CPU. Usa 0 para forzar cuda:0 o "cpu".
RAS_YOLO_DEVICE=
RAS_YOLO_CONFIDENCE=0.35
RAS_YOLO_CATEGORY_CONFIDENCE=0.45

# ---- Estación / Supabase ---------------------------------------------
# Identificador de esta estación física (debe existir en la tabla `stations`).
RAS_STATION_ID=station-001

# Supabase (Project Settings → API).
RAS_SUPABASE_URL=
RAS_SUPABASE_SERVICE_KEY=

# ---- Buffers locales --------------------------------------------------
# Directorio donde se guardan eventos pendientes si Supabase está caído.
RAS_LOCAL_BUFFER_DIR=var
